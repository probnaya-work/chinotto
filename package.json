{
  "name": "chinotto",
  "private": true,
  "version": "3.0.0",
  "description": "A private record of thoughts, encounters, and what continues between them.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Aleksandr Malinin",
  "homepage": "https://getchinotto.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/probnaya-work/chinotto.git"
  },
  "bugs": {
    "url": "https://github.com/probnaya-work/chinotto/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "npm run test:rs && npm run test:ts",
    "test:rs": "cd src-tauri && cargo test",
    "test:ts": "node --import tsx --test src/lib/urlInText.test.ts && vitest run",
    "build:macos": "npm run build && CI=false tauri build && ./scripts/sign-macos.sh",
    "build:macos-app": "npm run build && CI=false tauri build -b app -c '{\"bundle\":{\"createUpdaterArtifacts\":false}}' && ./scripts/sign-macos.sh",
    "build:macos-app:native": "npm run build && CI=false tauri build -b app -c '{\"bundle\":{\"createUpdaterArtifacts\":false}}' && ./scripts/codesign-macos-dev.sh",
    "tauri": "CI=false tauri",
    "preview": "vite preview",
    "deploy:hosting": "firebase deploy --only hosting"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "@tauri-apps/plugin-http": "^2.5.7",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "firebase": "^11.10.0",
    "framer-motion": "^12.35.2",
    "lucide-react": "^0.577.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-qr-code": "^2.0.18"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "typescript": "~5.6.2",
    "vite": "^6.0.1",
    "vitest": "^2.1.6"
  }
}
